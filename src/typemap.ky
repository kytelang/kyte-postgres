// typemap - type mapping between PostgreSQL's wire types and the `db` interface
// (SRP: types & values only). Three jobs:
//   - OID -> DbType             (oidToDbType)
//   - wire text -> typed DbValue (decodeCell, + bytea hex decode)
//   - DbValue -> SQL / bind text (valueToSql/valueToBindText + escaping, substituteParams)
// Pure over strings + the db value model; no socket, no framing.
import string;
import list;
import bytes;
import db;

// --- PostgreSQL type OIDs -> db-interface DbType --------------------------------------
pub fn oidToDbType(oid: int): DbType {
    if (oid == 16) { return DbType.Bool; }        // bool
    if (oid == 20) { return DbType.Int8; }        // int8
    if (oid == 21) { return DbType.Int4; }        // int2 -> Int4
    if (oid == 23) { return DbType.Int4; }        // int4
    if (oid == 26) { return DbType.Uint4; }       // oid
    if (oid == 700) { return DbType.Float4; }     // float4
    if (oid == 701) { return DbType.Float8; }     // float8
    if (oid == 1700) { return DbType.Decimal; }   // numeric
    if (oid == 1114) { return DbType.Timestamp; } // timestamp
    if (oid == 1184) { return DbType.Timestamp; } // timestamptz
    if (oid == 17) { return DbType.Blob; }         // bytea
    if (oid == 2950) { return DbType.Uuid; }       // uuid
    if (oid == 114) { return DbType.Json; }        // json
    if (oid == 3802) { return DbType.Json; }       // jsonb
    // Array types (element OID irrelevant to the db interface): _bool/_int2/_int4/_int8/_float4/_float8/
    // _numeric/_text/_varchar/_bpchar/_uuid/_json/_jsonb/_bytea. Decoded into DbType.Array elements.
    if (oid == 1000 || oid == 1005 || oid == 1007 || oid == 1016 || oid == 1021 || oid == 1022
     || oid == 1231 || oid == 1009 || oid == 1015 || oid == 1014 || oid == 2951 || oid == 199
     || oid == 3807 || oid == 1001) { return DbType.Array; }
    // text(25) / varchar(1043) / bpchar(1042) / name(19) / anything else -> Text
    return DbType.Text;
}

// Parse a PostgreSQL text-format array literal (e.g. `{1,2,3}`, `{a,"b,c",NULL}`, `{{1,2},{3,4}}`)
// into a list of element DbValues. Elements are decoded as TEXT (or a nested Array, or dbNull for the
// unquoted NULL token); per-element scalar typing would need the element OID, which the db interface's Column
// does not carry -- a follow-on. Handles double-quoted elements with `\"` / `\\` escapes and nesting.
fn parsePgArray(s: string): List<DbValue> {
    let out = List<DbValue>();
    let n = s.length;
    if (n < 2) { return out; }
    let i = 1;                                    // skip the opening '{'
    while (i < n && s[i] != 125) {                // 125 = '}'
        if (s[i] == 123) {                        // 123 = '{' -> nested array
            let depth = 0;
            let j = i;
            while (j < n) {
                if (s[j] == 123) { depth = depth + 1; }
                else if (s[j] == 125) { depth = depth - 1; if (depth == 0) { j = j + 1; } }
                else if (s[j] == 34) {            // 34 = '"' : skip a quoted run (may hold braces)
                    j = j + 1;
                    while (j < n && s[j] != 34) { if (s[j] == 92) { j = j + 1; } j = j + 1; }
                }
                if (depth == 0) { break; }
                j = j + 1;
            }
            out.push(db.dbArray(parsePgArray(string.slice(s, i, j))));
            i = j;
        } else if (s[i] == 34) {                  // quoted string element
            i = i + 1;
            let buf = "";
            while (i < n && s[i] != 34) {
                if (s[i] == 92 && i + 1 < n) { i = i + 1; }   // 92 = '\' : take the next char literally
                buf = buf + string.slice(s, i, i + 1);
                i = i + 1;
            }
            i = i + 1;                            // skip the closing quote
            out.push(db.dbText(buf));
        } else {                                  // unquoted element up to ',' or '}'
            let start = i;
            while (i < n && s[i] != 44 && s[i] != 125) { i = i + 1; }   // 44 = ','
            let tok = string.slice(s, start, i);
            if (string.eql(tok, "NULL")) { out.push(db.dbNull()); } else { out.push(db.dbText(tok)); }
        }
        if (i < n && s[i] == 44) { i = i + 1; }   // skip the element separator
    }
    return out;
}

// --- wire text -> typed DbValue -----------------------------------------------
fn hexNibble(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 97 + 10; }
    if (c >= 65 && c <= 70) { return c - 65 + 10; }
    return 0;
}
// "\xDEADBEEF" -> the 4 raw bytes.
pub fn decodeByteaHex(raw: string): string {
    let n = (raw.length - 2) / 2;
    if (n <= 0) { return ""; }
    let out = bytes.alloc(n);
    let i = 0;
    while (i < n) {
        let hi = hexNibble(raw[2 + i * 2]);
        let lo = hexNibble(raw[2 + i * 2 + 1]);
        bytes.write_byte(out, i, hi * 16 + lo);
        i = i + 1;
    }
    return out as string;
}

// Decode one text-format value into a typed cell for the column type.
pub fn decodeCell(t: DbType, raw: string, isNull: bool): DbValue {
    if (isNull) { return db.dbNull(); }
    if (t == DbType.Bool) {
        let tru = string.eql(raw, "t") || string.eql(raw, "true") || string.eql(raw, "1");
        return db.dbBool(tru);
    }
    if (t == DbType.Int4 || t == DbType.Uint4) { return db.dbInt(string.parseI64(raw)); }
    if (t == DbType.Int8 || t == DbType.Uint8) { return db.dbLong(string.parseI64(raw)); }
    // Temporal: pg text format is an ISO string (e.g. "2024-01-01 12:00:00+00"); keep it verbatim.
    // Forcing it through parseI64 (the old behaviour) yielded just the leading year -> garbage.
    if (t == DbType.Timestamp) { return db.dbTimestamp(raw); }
    if (t == DbType.Uuid) { return db.dbUuid(raw); }
    if (t == DbType.Json) { return db.dbJson(raw); }
    if (t == DbType.Array) { return db.dbArray(parsePgArray(raw)); }
    if (t == DbType.Float4 || t == DbType.Float8) { return db.dbDouble(string.parseFloat(raw)); }
    // bytea text format is "\xHEX..."; decode it to the raw bytes (a Blob). A non-\x value passes through.
    if (t == DbType.Blob) {
        if (raw.length >= 2 && raw[0] == 92 && raw[1] == 120) { return db.dbBlob(decodeByteaHex(raw)); }
        return db.dbBlob(raw);
    }
    if (t == DbType.Decimal) {
        // S4: numeric arrives as text - parse it into an EXACT decimal128 (.dec, via asDecimal())
        // while keeping the raw text in .s (asText) for callers that still want the string form.
        return DbValue(DbType.Decimal, 0, 0.0, decimal.fromString(raw), raw);
    }
    return db.dbText(raw);   // text / varchar / bytea
}

// --- DbValue -> Bind TEXT format ----------------------------------------------
// A parameter value in Bind's TEXT format (all format codes 0) - the server parses it per the
// prepared statement's inferred param type, so this is the raw unquoted text (unlike the
// client-side `valueToSql`, which quotes/escapes for inline interpolation).
pub fn valueToBindText(v: DbValue): string {
    if (v.kind == DbType.Bool) { if (v.asBool()) { return "t"; } return "f"; }
    if (v.kind == DbType.Text || v.kind == DbType.Blob) { return v.asText(); }
    if (v.kind == DbType.Decimal) { return v.asText(); }
    if (v.kind == DbType.Float4 || v.kind == DbType.Float8) { let d = v.asDouble(); return `${d}`; }
    let iv = v.asLong();
    return `${iv}`;
}

// --- DbValue -> inline SQL literal (client-side $N substitution) --------------
// Client-side $1..$N substitution with SQL-standard escaping (text single-quoted with
// doubled quotes) - used by `query`/`exec`. Prepared statements avoid it entirely.
fn escapeText(s: string): string {
    let out = "'";
    let i = 0;
    let n = s.length;
    while (i < n) {
        if (s[i] == 39) { out = out + "''"; } else { out = out + string.slice(s, i, i + 1); }
        i = i + 1;
    }
    return out + "'";
}
// bytea literal: '\xDEADBEEF'. Binary-safe (handles NUL/quotes), unlike text-escaping raw bytes.
fn byteaLiteral(s: string): string {
    let out = "'\\x";
    let i = 0;
    while (i < s.length) {
        let b = s[i];
        out = out + hexPair(b);
        i = i + 1;
    }
    return out + "'";
}
fn hexPair(b: int): string {
    let hi = (b / 16) & 15;
    let lo = b & 15;
    return hexDigit(hi) + hexDigit(lo);
}
fn hexDigit(v: int): string {
    if (v < 10) { return string.slice("0123456789", v, v + 1); }
    return string.slice("abcdef", v - 10, v - 10 + 1);
}
fn valueToSql(v: DbValue): string {
    if (v.isNull()) { return "NULL"; }
    if (v.kind == DbType.Bool) { if (v.asBool()) { return "true"; } return "false"; }
    if (v.kind == DbType.Blob) { return byteaLiteral(v.asText()); }
    if (v.kind == DbType.Text) { return escapeText(v.asText()); }
    if (v.kind == DbType.Decimal) { return v.asText(); }
    if (v.kind == DbType.Float4 || v.kind == DbType.Float8) { let d = v.asDouble(); return `${d}`; }
    let iv = v.asLong();
    return `${iv}`;
}
pub fn substituteParams(sql: string, params: List<DbValue>): string {
    let out = "";
    let i = 0;
    let n = sql.length;
    while (i < n) {
        // '$' followed by one or more digits -> parameter N (1-based). Multi-digit ($10, $123, ...) is
        // required: the ORM emits $1..$N for a struct's columns, so >9 columns were silently broken.
        if (sql[i] == 36 && i + 1 < n && sql[i + 1] >= 48 && sql[i + 1] <= 57) {
            let j = i + 1;
            let num = 0;
            while (j < n && sql[j] >= 48 && sql[j] <= 57) { num = num * 10 + (sql[j] - 48); j = j + 1; }
            let p = params.get(num - 1) ?? db.dbNull();
            out = out + valueToSql(p);
            i = j;
        } else {
            out = out + string.slice(sql, i, i + 1);
            i = i + 1;
        }
    }
    return out;
}
